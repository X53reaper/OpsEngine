# ── SAFARI ZETU BRIDGE ───────────────────────────────────────
SAFARI_ZETU_BRIDGE_URL=https://safarizetu.com/api/ops-bridge
SAFARI_ZETU_API_KEY=generate_32_char_hex_string
SAFARI_ZETU_WEBHOOK_SECRET=generate_64_char_hex_string

# ── LOCAL POSTGRESQL ─────────────────────────────────────────
# IMPORTANT: When running in Docker, POSTGRES_HOST is overridden to 'postgres'
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=safarizetu_ops
POSTGRES_USER=ops_admin
POSTGRES_PASSWORD=generate_strong_password
DATABASE_URL=postgresql://ops_admin:generate_strong_password@localhost:5432/safarizetu_ops

# ── N8N ──────────────────────────────────────────────────────
N8N_HOST=0.0.0.0
N8N_PORT=5678
N8N_PROTOCOL=https
N8N_HOST_URL=https://n8n.safarizetu.com
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=generate_strong_password
N8N_ENCRYPTION_KEY=generate_32_char_hex_string
WEBHOOK_URL=https://n8n.safarizetu.com

# ── LANGFUSE (LLM OBSERVABILITY) ──────────────────────────────
# Self-hosted via Docker — generate keys after first boot at http://localhost:3001
LANGFUSE_HOST=http://localhost:3001
LANGFUSE_PUBLIC_KEY=generate_after_langfuse_setup
LANGFUSE_SECRET_KEY=generate_after_langfuse_setup

# ── RESEND (EMAIL SENDING) ────────────────────────────────────
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM_EMAIL=ops@safarizetu.com
RESEND_FROM_NAME=Safari Zetu

# ── MEM0 (MEMORY SERVICE) ────────────────────────────────────
MEM0_API_KEY=generate_after_mem0_setup

# ── CLOUDFLARE TUNNEL ────────────────────────────────────────
# Option A: Token-based (recommended — get from Cloudflare Dashboard)
#   Create a tunnel at: https://one.dash.cloudflare.com/
#   Go to Networks > Tunnels > Create a tunnel > Docker
#   Copy the token here
CLOUDFLARE_TUNNEL_TOKEN=your_cloudflare_tunnel_token_here

# Option B: Credentials file (copy the JSON file to ~/.cloudflared/)
#   cloudflared tunnel login
#   cloudflared tunnel create safarizetu-ops
#   The credentials file will be created automatically at ~/.cloudflared/

